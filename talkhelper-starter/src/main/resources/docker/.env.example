# ═══════════════════════════════════════════════════════════════════════
# TalkHelper 环境变量配置
# 复制此文件为 .env 并根据实际情况修改
# ═══════════════════════════════════════════════════════════════════════

# DashScope API Key（阿里云灵积）
DASHSCOPE_API_KEY=sk-your-api-key-here

# JWT 密钥（生产环境请使用强密钥）
JWT_SECRET=your-secret-key-change-in-production
