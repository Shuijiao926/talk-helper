<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.talkhelper</groupId>
        <artifactId>talkhelper-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>talkhelper-web</artifactId>
    <packaging>jar</packaging>
    <name>TalkHelper Web Application</name>
    <description>Web启动模块 - 应用入口</description>

    <dependencies>
        <!-- 依赖所有业务模块 -->
        <dependency>
            <groupId>com.talkhelper</groupId>
            <artifactId>talkhelper-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        
        <dependency>
            <groupId>com.talkhelper</groupId>
            <artifactId>talkhelper-text-preprocess</artifactId>
            <version>${project.version}</version>
        </dependency>
        
        <dependency>
            <groupId>com.talkhelper</groupId>
            <artifactId>talkhelper-script-gen</artifactId>
            <version>${project.version}</version>
        </dependency>
        
        <dependency>
            <groupId>com.talkhelper</groupId>
            <artifactId>talkhelper-audio</artifactId>
            <version>${project.version}</version>
        </dependency>
        
        <dependency>
            <groupId>com.talkhelper</groupId>
            <artifactId>talkhelper-task</artifactId>
            <version>${project.version}</version>
        </dependency>
        
        <dependency>
            <groupId>com.talkhelper</groupId>
            <artifactId>talkhelper-resource</artifactId>
            <version>${project.version}</version>
        </dependency>
        
        <dependency>
            <groupId>com.talkhelper</groupId>
            <artifactId>talkhelper-user</artifactId>
            <version>${project.version}</version>
        </dependency>
        
        <dependency>
            <groupId>com.talkhelper</groupId>
            <artifactId>talkhelper-scheduler</artifactId>
            <version>${project.version}</version>
        </dependency>
        
        <!-- Spring Boot Starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        
        <!-- Database -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        
        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
